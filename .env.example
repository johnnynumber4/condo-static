# Copy to .env.local for development. In production these are set in the
# Vercel project settings, not committed.

# The unlisted /admin page. Without it that page refuses everyone rather than
# letting everyone in. Deliberately not NEXT_PUBLIC_: the prefix would ship it
# to the browser.
ADMIN_PASSWORD=

# The guest book at /suggestions. Without it the page tells guests it is not
# taking notes rather than showing them a form that would lose what they wrote.
# An Atlas connection string looks like:
#   mongodb+srv://user:password@cluster.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optional. Defaults to paradise252.
MONGODB_DB=
